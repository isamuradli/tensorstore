load("//bazel:tensorstore.bzl", "tensorstore_cc_binary")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

tensorstore_cc_binary(
    name = "test_parallel_client",
    srcs = ["test_parallel_client.cc"],
    deps = [
        "//tensorstore/kvstore",
        "//tensorstore/kvstore/remote_dram",
        "//tensorstore/kvstore:operations",
        "//tensorstore/util:result",
        "//tensorstore/util:status",
        "@abseil-cpp//absl/strings:cord",
        "@abseil-cpp//absl/time",
    ],
)

tensorstore_cc_binary(
    name = "test_memory_debug_client",
    srcs = ["test_memory_debug_client.cc"],
    deps = [
        "//tensorstore/kvstore",
        "//tensorstore/kvstore/remote_dram",
        "//tensorstore/kvstore:operations",
        "//tensorstore/util:result",
        "//tensorstore/util:status",
        "@abseil-cpp//absl/strings:cord",
        "@abseil-cpp//absl/time",
    ],
)