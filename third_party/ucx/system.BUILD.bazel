# UCX Service layer (UCS) - system package
cc_library(
    name = "ucs",
    defines = ["TENSORSTORE_SYSTEM_UCX"],
    linkopts = ["-L/usr/local/lib", "-lucs"],
    visibility = ["//visibility:public"],
)

# UCX Transport layer (UCT) - system package  
cc_library(
    name = "uct",
    defines = ["TENSORSTORE_SYSTEM_UCX"],
    linkopts = ["-L/usr/local/lib", "-luct"],
    deps = [":ucs"],
    visibility = ["//visibility:public"],
)

# UCX Protocol layer (UCP) - system package
cc_library(
    name = "ucp", 
    defines = ["TENSORSTORE_SYSTEM_UCX"],
    linkopts = ["-L/usr/local/lib", "-lucp"],
    deps = [":ucs", ":uct"],
    visibility = ["//visibility:public"],
)

# Main UCX library (convenience target)
cc_library(
    name = "ucx",
    defines = ["TENSORSTORE_SYSTEM_UCX"],
    linkopts = [
        "-L/usr/local/lib",
        "-Wl,-rpath,/usr/local/lib",
        "-lucp",
        "-luct", 
        "-lucs"
    ],
    visibility = ["//visibility:public"],
) 